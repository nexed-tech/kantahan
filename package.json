{
  "name": "kantahan",
  "version": "1.0.0-rc.3",
  "description": "Kantahan.app — self-hosted karaoke app",
  "main": "electron/main.js",
  "workspaces": [
    "client/display",
    "client/dj",
    "client/request"
  ],
  "scripts": {
    "dev": "concurrently -n srv,display,dj,req -c cyan,green,yellow,magenta \"nodemon server/index.js\" \"npm -w client/display run dev\" \"npm -w client/dj run dev\" \"npm -w client/request run dev\"",
    "build": "npm -w client/display run build && npm -w client/dj run build && npm -w client/request run build",
    "start": "cross-env NODE_ENV=production electron .",
    "start:server": "cross-env NODE_ENV=production node server/index.js",
    "pack:win": "npm run build && electron-builder --win",
    "pack:mac": "npm run build && electron-builder --mac",
    "pack:linux": "npm run build && electron-builder --linux",
    "pack": "npm run build && electron-builder --win --mac --linux"
  },
  "dependencies": {
    "adm-zip": "^0.5.17",
    "bcryptjs": "^3.0.3",
    "sql.js": "^1.12.0",
    "bonjour-service": "^1.3.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "ffprobe-static": "^3.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "qrcode": "^1.5.3",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^34.0.0",
    "electron-builder": "^24.0.0",
    "nodemon": "^3.0.3"
  },
  "build": {
    "appId": "app.kantahan",
    "productName": "Kantahan",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "server/**",
      "node_modules/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffprobe-static/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.music",
      "icon": "build/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "category": "AudioVideo",
      "icon": "build/icon.png"
    }
  }
}
